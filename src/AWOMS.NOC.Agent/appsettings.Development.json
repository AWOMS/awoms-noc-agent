{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "AWOMS.NOC.Agent": "Debug",
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AgentConfiguration": {
    "CollectionIntervalSeconds": 30,
    "ReportingIntervalSeconds": 300,
    "PublicIpUrl": "https://api.ipify.org/",
    "PingTargets": [
      "8.8.8.8",
      "1.1.1.1"
    ],
    "MonitoredServices": [
      "Dnscache",
      "LanmanServer",
      "LanmanWorkstation",
      "Spooler",
      "W32Time",
      "WinDefend"
    ]
  },
  "Thresholds": {
    "PasswordMaxAgeDays": 31,
    "PingLatencyWarningMs": 200,
    "CriticalUpdatesPendingDays": 7
  }
}
